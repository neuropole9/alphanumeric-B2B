APP_NAME=AlphaNumeric B2B Platform
APP_NAME=AlphaNumeric B2B Platform
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://alphanumeric:CHANGE_ME_POSTGRES_PASSWORD@db:5432/alphanumeric
