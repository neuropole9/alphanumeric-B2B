COOKIE_SECURE=true
ALLOWED_ORIGINS=https://your-domain.example
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=ADMIN_EMAIL_HERE
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_NAME=System Administrator
COMPANY_NAME=YOUR_LEGAL_COMPANY_NAME
COMPANY_GSTIN=YOUR_GSTIN
COMPANY_PAN=YOUR_PAN
COMPANY_ADDRESS=YOUR_REGISTERED_ADDRESS
COMPANY_PHONE=YOUR_BUSINESS_PHONE
COMPANY_EMAIL=YOUR_ACCOUNTS_EMAIL
COMPANY_LOGO_PATH=
BRAND_PRIMARY="#0B2E59"
BRAND_ACCENT="#1268DC"
BANK_NAME=YOUR_BANK_NAME
BANK_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
BANK_ACCOUNT_NUMBER=YOUR_ACCOUNT_NUMBER
BANK_IFSC=YOUR_IFSC
MEDIA_ROOT=./media
MEDIA_MAX_BYTES=8388608
MEDIA_MAX_FILES_PER_PRODUCT=12
MEDIA_STORAGE_PROVIDER=local
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
